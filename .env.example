# Copy this file to .env and fill the values locally.
# Never commit the real .env file.

# Port used by the Express server.
PORT=

# MongoDB Atlas connection string, including the salonbook database name.
MONGODB_URI=

# Random secret used by Better Auth to sign sessions and tokens.
BETTER_AUTH_SECRET=

# Public URL of this server, used by Better Auth.
BETTER_AUTH_URL=

# Public URL of the Next.js client, used for CORS and trusted origins.
CLIENT_URL=

# Google OAuth credentials used by Better Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test-mode credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB API key used by the server-side image upload route.
IMGBB_API_KEY=

# Admin account credentials used only by the admin seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
