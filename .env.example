# Copy this file to .env and fill the values locally.
# Never commit the real .env file.

# Port used by the Express server.
PORT=

# MongoDB Atlas connection string, including the salonbook database name.
MONGODB_URI=

# Random secret used by Better Auth to sign sessions and tokens.
BETTER_AUTH_SECRET=

# Public URL of this server, used by Better Auth.
BETTER_AUTH_URL=

# Public URL of the Next.js client, used for CORS and trusted origins.
CLIENT_URL=

# Optional extra client origins, separated by commas, for preview deployments or www aliases.
CLIENT_URLS=

# Google OAuth credentials used by Better Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe credentials. Never use a publishable (pk_) key here and never commit these values.
# For local development use a sk_test_ secret key from Stripe Dashboard -> Developers -> API keys.
# STRIPE_SECRET_KEY must start with sk_test_ (or sk_live_ only in production).
STRIPE_SECRET_KEY=
# Copy the signing secret from the webhook endpoint (Dashboard -> Developers -> Webhooks,
# or the `stripe listen` output for local development). It must start with whsec_.
# Each endpoint and each mode (test/live) has its own signing secret.
STRIPE_WEBHOOK_SECRET=

# ImgBB API key used by the server-side image upload route.
IMGBB_API_KEY=

# Admin account credentials used only by the admin seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
