{
  "name": "salonbook-server",
  "version": "1.0.0",
  "description": "REST API server for the SalonBook salon appointment booking platform.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:services": "tsx src/scripts/seedServices.ts"
  },
  "keywords": [
    "salon",
    "appointment-booking",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Rakib",
  "license": "ISC",
  "dependencies": {
    "better-auth": "^1.7.26",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jose": "^6.2.18",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
